# Bisect variant of config-sukisu.env (kept in sync manually); used by the
# workflow target sukisu-nokpm.
# Base section options
KERNEL_SOURCE=https://github.com/Tanuki33/android_kernel_xiaomi_mt6768_S_Vendor
KERNEL_SOURCE_BRANCH=LineaTan
# Pin the kernel source to an exact commit; empty = build the branch tip.
# b02c8bd = last tree revision known to boot (before the screenoff-workqueue and
# watermark-boosting/schedutil commits), used to isolate a boot regression from
# the SukiSU/SUSFS integration. Clear this to build LineaTan HEAD again.
KERNEL_COMMIT=b02c8bdaebaf27227ace10260bd0a638ba5f7fc0
KERNEL_ARCH=arm64
KERNEL_IMAGE_NAME=Image.gz-dtb

# 4.19 config layout: common MT6768 base config + device fragment (merlin)
KERNEL_CONFIG_BASE=vendor/mt6768_defconfig
KERNEL_CONFIG_FRAGMENT_DIR=vendor

# Kernel identity: shows up in `uname -r` (...-LineaTan) and in the AnyKernel3 installer
KERNEL_NAME=LineaTan
KERNEL_AUTHOR=Tanuki33

# KernelSU section options
# SukiSU-Nova (fork of SukiSU-Ultra / KernelSU). Manager is com.sukisu.ultra.
# The driver is cloned directly from the `builtin` branch: that is the non-GKI
# variant, it registers no kprobes and instead expects the kernel source to call
# its hook entry points (ksu_handle_execveat / _faccessat / _stat / _vfs_read /
# _sys_read / _vfs_fstat / _sys_reboot), hence patches/SUKISU_HOOKS_PATCH.patch.
# Note: CONFIG_KSU_MANUAL_HOOK / CONFIG_KSU_TRACEPOINT_HOOK no longer exist in
# this driver, so KSU_MANUAL_HOOKS stays false and the configs are not written.
ENABLE_KERNELSU=true
KSU_NAME=SukiSU-Nova
# Canonical upstream (ShirkNeko's own git server, what kernel/setup.sh clones).
# If this host ever becomes unreachable from Actions, fall back to the GitHub
# mirror, which lags a few days: https://github.com/SukiSU-Nova/SukiSU-Nova
KERNELSU_REPO=https://git.zako.shirkneko.top:20004/shirkneko/SukiSU
KERNELSU_REPO_BRANCH=builtin
KERNELSU_SETUP_SOURCE=
KERNELSU_TAG=
ADD_KPROBES_CONFIG=false
KSU_HOOKS_PATCH=true
# Hook patch file used by the workflow (relative to patches/); empty = auto-detect.
# SUKISU_SUSFS_4.19.patch = hook patch + SUSFS v2.4.0 kernel integration
# (fs/susfs.c, include/linux/susfs*.h, all fs/mm/security hook sites).
# Use SUKISU_HOOKS_PATCH.patch instead for a SUSFS-less build.
KSU_HOOKS_PATCH_FILE=SUKISU_SUSFS_4.19.patch
# Patch applied inside the cloned driver tree (patches/):
#  - guards the 4.19 cpu_spoof elf_hwcap store, which would otherwise write
#    past a single word;
#  - guards <linux/static_call.h> (5.10+ header, unused by the driver) so the
#    driver compiles on this 4.19 tree.
KSU_DRIVER_PATCH=SUKISU_DRIVER_4.19.patch
# The driver resolves kernel symbols via kallsyms_on_each_symbol()
KSU_KALLSYMS=true
# SukiSU KPM (kernel module loading) is compiled in by default. Needs 64-bit +
# KALLSYMS_ALL; upstream warns it can affect stability, set false to drop it.
KSU_KPM=false
KSU_MANUAL_HOOKS=false
KSU_BRANCH_LINK_HOOK=false
# SUSFS v2.4.0 is enabled by default: it is what unlocks the SukiSU-Nova
# hiding/spoofing feature set (sus_path, sus_mount, sus_kstat, uname spoof,
# cmdline/bootconfig spoof, open_redirect, sus_map, priority uid filter).
# Requires KSU_HOOKS_PATCH=true (the patch ships the extra setresuid and
# post_execveat_sucompat hook call-sites SUSFS mode needs).
KSU_SUSFS=true
KSU_REVERT=false
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# APatch section options
ADD_APATCH_SUPPORT=false
FIX_APATCH_OPENELA=false

# Compiler section options
# AOSP clang-r416183b = the exact toolchain LineageOS uses for this 4.19 MT6768 tree
# (TARGET_KERNEL_CLANG_VERSION := r416183b in device_xiaomi_mt6768-common)
USE_CLANG=true
CLANG_SOURCE=https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/b669748458572622ed716407611633c5415da25c/clang-r416183b.tar.gz
CLANG_BRANCH=
USE_GCC=false
USE_GCC_64=false
GCC_64_SOURCE=https://snapshots.linaro.org/gnu-toolchain/14.0-2023.06-1/aarch64-linux-gnu/gcc-linaro-14.0.0-2023.06-x86_64_aarch64-linux-gnu.tar.xz
GCC_64_BRANCH=
USE_GCC_32=false
GCC_32_SOURCE=https://snapshots.linaro.org/gnu-toolchain/14.0-2023.06-1/arm-linux-gnueabihf/gcc-linaro-14.0.0-2023.06-x86_64_arm-linux-gnueabihf.tar.xz
GCC_32_BRANCH=

# Anykernel3 section options
USE_ANYKERNEL3=true
ANYKERNEL3_SOURCE=https://github.com/Tanuki33/AnyKernel3.git
ANYKERNEL3_BRANCH=LineaTan

# Build section options
EXTRA_CMDS=LLVM=1 LLVM_IAS=1 CROSS_COMPILE=aarch64-linux-gnu- CONFIG_NO_ERROR_ON_MISMATCH=y TARGET_BUILD_VARIANT=user
DISABLE_LTO=
DISABLE_CC_WERROR=
ENABLE_PYTHON2=false
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=false
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=https://raw.githubusercontent.com/xiaoleGun/KernelSU_action/main/boot/boot.img

# Misc section options
ADD_OVERLAYFS_CONFIG=false

# Connectivity section options
# The kernel tree ships its own MTK connectivity driver, so keep this off
FIX_WIFI_SPEED=false

# FOR KPM
KPM_SUPPORT=false
KPM_URL=https://github.com/SukiSU-Ultra/SukiSU_KernelPatch_patch/releases/download/0.12.2/patch_linux
