# Base section options
KERNEL_SOURCE=https://github.com/Tanuki33/android_kernel_xiaomi_mt6768_S_Vendor
KERNEL_SOURCE_BRANCH=LineaTan
KERNEL_ARCH=arm64
KERNEL_IMAGE_NAME=Image.gz-dtb

# 4.19 config layout: common MT6768 base config + device fragment (merlin)
KERNEL_CONFIG_BASE=vendor/mt6768_defconfig
KERNEL_CONFIG_FRAGMENT_DIR=vendor

# Kernel identity: shows up in `uname -r` (...-LineaTan) and in the AnyKernel3 installer
KERNEL_NAME=LineaTan
KERNEL_AUTHOR=Tanuki33

# KernelSU section options
# MidoriSU: manager is com.midori.supermanager, driver is the branch that tracks
# backslashxx/KernelSU (the non-GKI driver, Linux 3.0 - 5.4+). The driver accepts
# the MidoriSU / KOWX712 / official KernelSU manager signatures out of the box.
ENABLE_KERNELSU=true
KSU_NAME=MidoriSU
KERNELSU_REPO=https://github.com/midori01/KernelSU
KERNELSU_REPO_BRANCH=xx
KERNELSU_SETUP_SOURCE=
KERNELSU_TAG=
ADD_KPROBES_CONFIG=false
KSU_HOOKS_PATCH=false
KSU_MANUAL_HOOKS=false
KSU_BRANCH_LINK_HOOK=true
# SUSFS: kernel side comes from patches/MIDORISU_SUSFS_4.19.patch (de-inlined
# SUSFS v2.4.0 for this 4.19 tree, no KernelSU hook call-sites because the
# branch-link driver hijacks its own hooks at runtime).
KSU_SUSFS=true
KSU_SUSFS_PATCH_FILE=MIDORISU_SUSFS_4.19.patch
KSU_REVERT=false
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# APatch section options
ADD_APATCH_SUPPORT=false
FIX_APATCH_OPENELA=false

# Compiler section options
# AOSP clang-r416183b = the exact toolchain LineageOS uses for this 4.19 MT6768 tree
# (TARGET_KERNEL_CLANG_VERSION := r416183b in device_xiaomi_mt6768-common)
USE_CLANG=true
CLANG_SOURCE=https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/b669748458572622ed716407611633c5415da25c/clang-r416183b.tar.gz
CLANG_BRANCH=
USE_GCC=false
USE_GCC_64=false
GCC_64_SOURCE=https://snapshots.linaro.org/gnu-toolchain/14.0-2023.06-1/aarch64-linux-gnu/gcc-linaro-14.0.0-2023.06-x86_64_aarch64-linux-gnu.tar.xz
GCC_64_BRANCH=
USE_GCC_32=false
GCC_32_SOURCE=https://snapshots.linaro.org/gnu-toolchain/14.0-2023.06-1/arm-linux-gnueabihf/gcc-linaro-14.0.0-2023.06-x86_64_arm-linux-gnueabihf.tar.xz
GCC_32_BRANCH=

# Anykernel3 section options
USE_ANYKERNEL3=true
ANYKERNEL3_SOURCE=https://github.com/Tanuki33/AnyKernel3.git
ANYKERNEL3_BRANCH=LineaTan

# Build section options
EXTRA_CMDS=LLVM=1 LLVM_IAS=1 CROSS_COMPILE=aarch64-linux-gnu- CONFIG_NO_ERROR_ON_MISMATCH=y TARGET_BUILD_VARIANT=user
DISABLE_LTO=
DISABLE_CC_WERROR=
ENABLE_PYTHON2=false
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=false
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=https://raw.githubusercontent.com/xiaoleGun/KernelSU_action/main/boot/boot.img

# Misc section options
ADD_OVERLAYFS_CONFIG=false

# Connectivity section options
# The kernel tree ships its own MTK connectivity driver, so keep this off
FIX_WIFI_SPEED=false

# FOR KPM
KPM_SUPPORT=false
KPM_URL=https://github.com/SukiSU-Ultra/SukiSU_KernelPatch_patch/releases/download/0.12.2/patch_linux
